# Copiar como application-local.properties (ignorado por git) y completar.
# Es la clave del rol "clinica" que crea backend/db/init.sql.
spring.datasource.password=cambiar-esta-clave

# Secreto para firmar los JWT. Generar uno random y largo, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
jwt.secret=cambiar-este-secreto-por-uno-random-y-largo

# Solo desarrollo local: crea un admin de demostración (admin@clinica.test / admin1234) en el primer
# arranque si todavía no hay ningún admin. NO activar fuera de tu máquina: en un entorno real se
# define ADMIN_EMAIL y ADMIN_PASSWORD (ver AdminSeeder).
clinica.seed.demo-admin=true

# Solo desarrollo local: carga dos profesionales de demostracion por especialidad (con consultorio y horarios), para
# poder probar la reserva de turnos en cualquier especialidad. Sin contraseña conocida (ver MedicosDeDemostracion).
clinica.seed.demo-medicos=true

# Solo desarrollo local: una cuenta por rol (paciente, medico, recepcion) con contraseña publica, para probar cada
# pantalla sin crear usuarios (ver CuentasDeDemostracion y el README).
clinica.seed.demo-cuentas=true
